{
  "openapi": "3.0.3",
  "info": {
    "title": "Auth API",
    "version": "1.0"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Регистрация",
        "responses": {
          "201": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "account": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "login": {
                          "type": "string"
                        },
                        "premium": {
                          "type": "boolean"
                        },
                        "adsEnabled": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "login",
                        "premium",
                        "adsEnabled"
                      ]
                    }
                  },
                  "required": [
                    "token",
                    "account"
                  ]
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "login": {
                    "type": "string",
                    "example": "movie_fan"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128,
                    "format": "password"
                  }
                },
                "required": [
                  "login",
                  "password"
                ]
              }
            }
          }
        },
        "tags": [
          "Auth"
        ],
        "operationId": "register"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Вход",
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "account": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "login": {
                          "type": "string"
                        },
                        "premium": {
                          "type": "boolean"
                        },
                        "adsEnabled": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "login",
                        "premium",
                        "adsEnabled"
                      ]
                    }
                  },
                  "required": [
                    "token",
                    "account"
                  ]
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "login": {
                    "type": "string",
                    "example": "movie_fan"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128,
                    "format": "password"
                  }
                },
                "required": [
                  "login",
                  "password"
                ]
              }
            }
          }
        },
        "tags": [
          "Auth"
        ],
        "operationId": "login"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Выход",
        "responses": {
          "204": {
            "description": "Успешно"
          }
        },
        "tags": [
          "Auth"
        ],
        "operationId": "logout"
      }
    }
  }
}
